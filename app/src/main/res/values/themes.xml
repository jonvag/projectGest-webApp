<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ProjectGest" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fondo</item>
    </style>

    <!-- Splash de arranque: se muestra mientras se lee la sesión guardada. -->
    <style name="Theme.ProjectGest.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fondo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ProjectGest</item>
    </style>
</resources>
